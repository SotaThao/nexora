# App environment label (development | test | staging | production)
VITE_APP_ENV=development

# API base URL used by src/lib/httpClient.js (no trailing slash)
VITE_API_BASE_URL=

# Legacy API key for older screens (kept for backward compatibility)
VITE_API_BASE=

# Data source selector used by src/data/adapters/index.js (storage | api)
VITE_DATA_SOURCE=storage

# Demo tools flag (only enabled for local demo/debug sessions)
VITE_ENABLE_DEMO_TOOLS=false

# Optional observability config
VITE_SENTRY_ENV=
VITE_SENTRY_DSN=

# Existing project public config values (set per environment in GitHub Environments)
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_TOKEN=
VITE_MAP_MARKER_ENGINE=advanced
VITE_GOOGLE_MAPS_MAP_ID=
VITE_VLINKPAY_WEB_URL_BASE=
