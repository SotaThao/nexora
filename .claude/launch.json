{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true,
      "env": {
        "VITE_ENABLE_DEMO_TOOLS": "true"
      }
    },
    {
      "name": "dev-staging",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:staging"],
      "port": 3000
    }
  ]
}
