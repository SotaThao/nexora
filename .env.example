# ─── API ────────────────────────────────────────────────────────────────────
# Base URL for the real backend API (no trailing slash).
# For local development, point at the dev backend so flows that hit real
# endpoints (e.g. the staff invite magic-link /invite/{token}) work the same
# way they do on the test environment.
#
#   Local dev / test:  https://test-api.nexoratouch.com
#
# Leave empty only if you serve the API from the dev-server origin or via a
# Vite proxy (see note at the bottom).
VITE_API_BASE_URL=https://test-api.nexoratouch.com

# ─── Data source ────────────────────────────────────────────────────────────
# Controls which adapter the data-access layer uses.
#   api      — reads/writes via httpClient.js against VITE_API_BASE_URL.
#              Requires the backend to be reachable. This is the current mode.
#   storage  — legacy: reads/writes via storage.js (localStorage). No real API.
VITE_DATA_SOURCE=api

# ─── Demo tools ─────────────────────────────────────────────────────────────
# Default off for production-like runtime. Set to true only for local demos or
# e2e smoke tests that intentionally exercise the simulation panel.
VITE_ENABLE_DEMO_TOOLS=false

# ─── CORS note ──────────────────────────────────────────────────────────────
# When running `pnpm dev` at http://localhost:3000, the browser calls the dev
# API cross-origin. If the API blocks localhost (CORS error in the console),
# either ask the backend to allow http://localhost:3000, or add a Vite dev
# proxy in vite.config.js (server.proxy '/api' -> dev API) and set
# VITE_API_BASE_URL= (empty) in .env.local so requests go same-origin.
