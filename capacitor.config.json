{
  "appId": "net.vlinkgroup.nexora",
  "appName": "Nexora Touch",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "localhost"
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": true,
    "initialFocus": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": false,
      "animation": "NONE"
    },
    "CapacitorUpdater": {
      "appId": "net.vlinkgroup.nexora",
      "autoUpdate": "atBackground",
      "version": "0.0.1",
      "defaultChannel": "production"
    }
  }
}
