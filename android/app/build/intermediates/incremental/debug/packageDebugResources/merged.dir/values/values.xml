<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#6366F1</color>
    <color name="colorPrimary">#0B1C30</color>
    <color name="colorPrimaryDark">#081525</color>
    <color name="splash_background">#0B1C30</color>
    <string name="app_name">Nexora Touch</string>
    <string name="custom_url_scheme">net.vlinkgroup.nexora</string>
    <string name="package_name">net.vlinkgroup.nexora</string>
    <string name="title_activity_main">Nexora Touch</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>