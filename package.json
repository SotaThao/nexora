{
  "name": "vlinknexora",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.cjs",
    "lint:tokens": "node scripts/verify-tokens.cjs",
    "test:impact": "node .agents/skills/feature-focused-tester/scripts/detect-changes.cjs",
    "seed:staff-demo": "node scripts/seed-staff-demo.js",
    "version:sync": "node scripts/bump-app-version.js --sync-only",
    "cap:sync": "node scripts/bump-app-version.js --sync-only && pnpm build && npx cap sync",
    "sync":"pnpm build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "capgo:init": "npx @capgo/cli init",
    "capgo:setup": "npx @capgo/cli app add net.vlinkgroup.nexora && npx @capgo/cli channel add production net.vlinkgroup.nexora --default --self-assign",
    "capgo:bump": "node scripts/bump-app-version.js",
    "capgo:upload": "node scripts/capgo-upload.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capgo/capacitor-updater": "^8.49.0",
    "@tanstack/react-query": "^5.0.0",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@capgo/cli": "^8.1.2",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "cloakbrowser": "^0.3.31",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "postcss": "^8.4.38",
    "start-server-and-test": "^3.0.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.2.0",
    "vitest": "^2.1.8"
  }
